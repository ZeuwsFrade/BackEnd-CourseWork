{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "api/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "api/products/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "api/orders/{**catch-all}"
        }
      },
      "chats-route": {
        "ClusterId": "chats-cluster",
        "Match": {
          "Path": "api/chats/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "products-service": {
            "Address": "http://localhost:5149/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-service": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "chats-cluster": {
        "Destinations": {
          "chats-service": {
            "Address": "http://localhost:5004/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}