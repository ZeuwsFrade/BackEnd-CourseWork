            "maxLength": 200,
            "minLength": 3,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0,01,
            "type": "number",
            "format": "double"
          },
          "category": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
